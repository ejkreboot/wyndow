# Copy to .env and fill in. Never commit .env.

# Supabase project (Settings → API). All three are read on the server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Comma-separated emails allowed to sign in. The app refuses to start without it.
ALLOWED_EMAILS=you@example.com

# Bearer token for the Vercel cron that refreshes calendar feeds (16+ characters).
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Optional: fine-grained GitHub token for your venture repos with Issues: read and write
# (and Metadata: read). Wyndow reads and edits issues, labels, and milestones with it.
GITHUB_TOKEN=
